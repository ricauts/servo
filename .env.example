# Main application database — PostgreSQL (start it with `docker compose up -d db`).
DATABASE_URL="postgresql://servo:servo@localhost:5432/servo?schema=public"
# The ops sandbox: its own database with its own login roles, created by
# scripts/postgres-init.sql (docker compose applies it on a fresh volume;
# docs/migrating-to-postgres.md carries the same SQL for existing ones).
# /api/setup and the ops tools refuse with a message naming this variable
# when it is unset. The passwords below are the ones postgres-init.sql sets.
OPS_DATABASE_URL="postgresql://servo_ops_rw:servo_ops_rw@localhost:5432/servo_ops"
# Recommended: the read-only role for query_ops_database and get_device_info.
# Reads are wrapped in SET TRANSACTION READ ONLY either way (src/lib/opsdb.ts);
# this role adds default_transaction_read_only and SELECT-only grants under it.
OPS_DATABASE_READONLY_URL="postgresql://servo_ops_ro:servo_ops_ro@localhost:5432/servo_ops"

# STRONGLY recommended in production: encrypts stored secrets (API keys,
# tokens, SMTP URLs…) at rest with AES-256-GCM. 64 hex chars, 32-byte
# base64, or any long passphrase. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Existing plaintext rows migrate with: node scripts/encrypt-secrets.cjs
# SERVO_ENCRYPTION_KEY=...

# Optional: bring your own key via environment instead of the Settings UI.
# When unset and no key is stored in Settings, Servo runs in deterministic
# mock mode so the whole demo works offline.
#
# Used when the provider is "anthropic" (Anthropic API or any
# Anthropic-compatible endpoint, e.g. Z.AI via the base URL setting):
# ANTHROPIC_API_KEY=sk-ant-...
#
# Used when the provider is "openai" (any OpenAI-compatible endpoint:
# OpenAI, Azure OpenAI, Z.AI, vLLM…; keyless local endpoints like Ollama
# only need the base URL):
# OPENAI_API_KEY=sk-...
# Used when the provider is "zai" (Z.AI GLM, first-class provider):
# ZAI_API_KEY=...

# Optional: real GitHub integration for github_create_repo / github_open_pr.
# Takes precedence over the token stored in Settings. Without a token the
# GitHub tools run simulated.
# GITHUB_TOKEN=github_pat_...

# Optional: read-only Azure integration for azure_list_resources.
# A service principal with the Reader role on the subscription is enough.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=...
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Optional: outbound email notifications. Takes precedence over the SMTP URL
# stored in Settings. Enable the switch in Settings → Email notifications.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# Base URL used in notification links (defaults to http://localhost:3000):
# APP_URL=https://servo.example.com

# Optional: shared secret for the inbound-email webhook
# (POST /api/inbound/email, sent as the x-servo-token header or ?token=).
# Enable the switch in Settings → Integrations → Inbound email.
# INBOUND_EMAIL_SECRET=a-long-random-string

# Optional: lets a scheduler run the SLA breach scan without a session
# (POST /api/sla/scan with the x-servo-token header).
# SLA_SCAN_SECRET=another-long-random-string

# --- Authentication (SSO / OIDC) --------------------------------------------
# With the three OIDC_* values set (or saved from Integrations), Servo runs
# real sign-in; without them it stays in the offline demo user-switcher.
# Redirect URI to register in your IdP: <servo-url>/api/auth/callback/oidc
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_PROVIDER_NAME=Company SSO
# Comma-separated emails auto-promoted to ADMIN at sign-in:
# AUTH_ADMIN_EMAILS=you@company.com
# Comma-separated email domains allowed to sign in (admin emails always pass).
# Recommended whenever the IdP accepts accounts outside your organization;
# empty allows any account the IdP authenticates:
# AUTH_ALLOWED_DOMAINS=company.com
# REQUIRED in production for session signing (any long random string):
# AUTH_SECRET=...
# Local development IdP: node scripts/mock-idp.mjs you@company.com
# --- IMAP relay (Gmail / Google Workspace inbound) ---------------------------
# Gmail has no native inbound webhook; run `node scripts/imap-relay.mjs` next
# to Servo to forward unseen mail into POST /api/inbound/email. The mailbox
# needs IMAP enabled and an app password (2-Step Verification required).
# IMAP_HOST=imap.gmail.com
# IMAP_USER=tickets@company.com
# IMAP_PASSWORD=<16-char app password>
# SERVO_URL=http://localhost:3000
# IMAP_POLL_SECONDS=30
# Optional: bearer token for the MCP server endpoint (POST /api/mcp).
# Takes precedence over the token stored in Integrations -> MCP server.
# MCP_TOKEN=a-long-random-string