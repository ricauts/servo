{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/product/**",
              "ui_kits/desk/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Chivo|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Chivo, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|good|warn|critical)$/]",
        "message": "<Alert> tone must be one of 'brand' | 'good' | 'warn' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:ticketNumber|ticketTitle|toolName|toolInput|risk|requestedAt|agentName|blockedFor|impact|diff|canDecide|onApprove|onReject|key|ref|className|style|children)$/]",
        "message": "<ApprovalCard> doesn't accept that prop. Declared props: ticketNumber, ticketTitle, toolName, toolInput, risk, requestedAt, agentName, blockedFor, impact, diff, canDecide, onApprove, onReject."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalCard'] > JSXAttribute[name.name='risk'] > Literal[value!=/^(?:LOW|MEDIUM|HIGH)$/]",
        "message": "<ApprovalCard> risk must be one of 'LOW' | 'MEDIUM' | 'HIGH'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|size|isAi|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, color, size, isAi."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|quiet|solid|square|icon|children|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, quiet, solid, square, icon, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconStart|iconEnd|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconStart, iconEnd."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|ghost|subtle|danger|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'ghost' | 'subtle' | 'danger' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|action|footer|padded|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, description, action, footer, padded, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|number|key|ref|className|style|children)$/]",
        "message": "<CommandItem> doesn't accept that prop. Declared props: label, icon, number."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|children|confirmLabel|cancelLabel|onConfirm|onCancel|tone|inline|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, description, children, confirmLabel, cancelLabel, onConfirm, onCancel, tone, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|danger)$/]",
        "message": "<Dialog> tone must be one of 'primary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, children, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|htmlFor|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, htmlFor, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:mono|invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: mono, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|actions|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: eyebrow, title, subtitle, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReplyDraftCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:draftedBy|when|value|recipient|onChange|onApprove|onRegenerate|onDiscard|key|ref|className|style|children)$/]",
        "message": "<ReplyDraftCard> doesn't accept that prop. Declared props: draftedBy, when, value, recipient, onChange, onApprove, onRegenerate, onDiscard."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunDecision'] > JSXAttribute > JSXIdentifier[name!=/^(?:approved|by|key|ref|className|style|children)$/]",
        "message": "<RunDecision> doesn't accept that prop. Declared props: approved, by."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:vertical|style|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: vertical, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|icon|count|attention|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: href, label, icon, count, attention."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlaBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|kind|key|ref|className|style|children)$/]",
        "message": "<SlaBadge> doesn't accept that prop. Declared props: state, label, kind."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlaBadge'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:met|ok|at_risk|breached|none)$/]",
        "message": "<SlaBadge> state must be one of 'met' | 'ok' | 'at_risk' | 'breached' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlaBadge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:response|resolution)$/]",
        "message": "<SlaBadge> kind must be one of 'response' | 'resolution'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<Spinner> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|highlight|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, unit, highlight."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='highlight'] > Literal[value!=/^(?:warn|critical|brand)$/]",
        "message": "<StatTile> highlight must be one of 'warn' | 'critical' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|width|align|mono|render|key|ref|className|style|children)$/]",
        "message": "<TableColumn> doesn't accept that prop. Declared props: key, label, width, align, mono, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<TableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|requester|status|priority|category|assignee|assigneeIsAi|slaState|slaLabel|updated|key|ref|className|style|children)$/]",
        "message": "<TicketRow> doesn't accept that prop. Declared props: number, title, requester, status, priority, category, assignee, assigneeIsAi, slaState, slaLabel, updated."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:OPEN|TRIAGED|IN_PROGRESS|WAITING_APPROVAL|RESOLVED|CLOSED)$/]",
        "message": "<TicketRow> status must be one of 'OPEN' | 'TRIAGED' | 'IN_PROGRESS' | 'WAITING_APPROVAL' | 'RESOLVED' | 'CLOSED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketRow'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:LOW|MEDIUM|HIGH|URGENT)$/]",
        "message": "<TicketRow> priority must be one of 'LOW' | 'MEDIUM' | 'HIGH' | 'URGENT'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketRow'] > JSXAttribute[name.name='slaState'] > Literal[value!=/^(?:met|ok|at_risk|breached|none)$/]",
        "message": "<TicketRow> slaState must be one of 'met' | 'ok' | 'at_risk' | 'breached' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|isAi|badge|action|when|system|last|children|key|ref|className|style|children)$/]",
        "message": "<TimelineEntry> doesn't accept that prop. Declared props: author, isAi, badge, action, when, system, last, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|kbd|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: children, kbd."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tagline|color|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tagline, color."
      }
    ]
