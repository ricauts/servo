// Servo data model. Enum-like fields are strings BY CHOICE, not by dialect:
// a Prisma enum turns "add a status / a role / a category" into a migration
// plus a deploy, and the extensibility story (installed packs contributing
// categories, custom roles) depends on those values being data. The union
// types in src/lib/types.ts are the single source of truth for the values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String // ADMIN | AGENT | REQUESTER | AI_AGENT
  aiKind    String? // TRIAGE | RESOLVER | QA (only when role = AI_AGENT)
  color     String   @default("#165A56")
  createdAt DateTime @default(now())

  requestedTickets Ticket[]      @relation("requester")
  assignedTickets  Ticket[]      @relation("assignee")
  comments         Comment[]
  decisions        Approval[]    @relation("decider")
  draftDecisions   ReplyDraft[]  @relation("draftDecider")
  memberships      GroupMember[]
  ownedDocuments   Document[]
  grantedKb        KbGrant[]     @relation("kbGranter")
  createdSources   DataSource[]
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  categories  String   @default("[]") // JSON: Category[] whose tickets route to this group
  createdAt   DateTime @default(now())

  members GroupMember[]
  tickets Ticket[]
}

model GroupMember {
  id        String @id @default(cuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seniority String @default("JUNIOR") // JUNIOR | MID | SENIOR | STANDALONE (specialist outside the ladder)

  @@unique([groupId, userId])
}

model Ticket {
  id              String    @id @default(cuid())
  number          Int       @unique
  title           String
  description     String
  status          String    @default("OPEN") // OPEN | TRIAGED | IN_PROGRESS | WAITING_APPROVAL | RESOLVED | CLOSED
  // Where the ticket entered the desk (ux-03): WEB form, inbound EMAIL, or
  // the MCP create_ticket tool. CHAT exists in the TicketChannel union but
  // is deliberately unused until the chat surface ships (ux-07) — nobody
  // deletes it, nobody claims it ships.
  channel         String    @default("WEB") // TicketChannel: WEB | EMAIL | MCP | CHAT
  priority        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  category        String    @default("OTHER") // ACCESS | HARDWARE | SOFTWARE | DATABASE | DEVOPS | NETWORK | OTHER
  requesterId     String
  requester       User      @relation("requester", fields: [requesterId], references: [id])
  assigneeId      String?
  assignee        User?     @relation("assignee", fields: [assigneeId], references: [id])
  groupId         String?
  group           Group?    @relation(fields: [groupId], references: [id])
  escalationLevel String    @default("JUNIOR") // JUNIOR | MID | SENIOR — current handling tier
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  // SLA targets derived from the priority's policy; recomputed when the
  // priority changes. slaEscalatedAt makes breach escalation fire once.
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  slaEscalatedAt  DateTime?

  comments    Comment[]
  runs        AgentRun[]
  approvals   Approval[]
  drafts      ReplyDraft[]
  attachments Attachment[]
}

// An AI-drafted reply to the requester awaiting a human decision — the daily
// support workflow: mail arrives, the AI writes the answer, a human approves
// (optionally after editing) and Servo emails it out as a public comment.
model ReplyDraft {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body      String
  status    String    @default("PENDING") // PENDING | SENT | REJECTED
  agentName String    @default("Servo Drafter") // persona that wrote the draft
  emailed   Boolean   @default(false) // approved reply actually left via SMTP
  edited    Boolean   @default(false) // human changed the AI text before sending
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  deciderId String?
  decider   User?     @relation("draftDecider", fields: [deciderId], references: [id])
  // Provenance by construction (kb-12): exactly the chunks injected into the
  // drafter's prompt — {docId, docName, locator, chunkId}[].
  sources      Json    @default("[]")
  autoDelivered Boolean @default(false) // sent by policy with deciderId null (kb-14)
}

// A file produced while working a ticket — today, screenshots captured by the
// agents so a human can SEE a proposed UI change before approving it. Stored
// in the database on purpose: it survives container restarts on the same
// volume and needs no filesystem configuration.
model Attachment {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  name        String
  contentType String   @default("image/png")
  data        Bytes
  caption     String   @default("")
  createdAt   DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  kind      String   @default("COMMENT") // COMMENT | SYSTEM
  createdAt DateTime @default(now())
}

model AgentRun {
  id           String    @id @default(cuid())
  ticketId     String
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agentUserId  String // the AI_AGENT user executing this run
  profileId    String? // specialized agent profile used (RESOLVE runs)
  profile      AgentProfile? @relation(fields: [profileId], references: [id])
  kind         String // TRIAGE | RESOLVE
  status       String    @default("RUNNING") // RUNNING | WAITING_APPROVAL | COMPLETED | FAILED
  conversation String    @default("[]") // JSON: provider message history, used to resume after approvals
  summary      String?
  error        String?
  qaVerdict    String? // PASS | FAIL
  qaNotes      String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  // The retrieval ledger (cat-01, canonized in docs/design/data-fabric.md):
  // {probed, opened, discarded, perDataset, chars, hops, finds, compacted} —
  // every charge is a read-modify-write inside a transaction on this row.
  retrieval    Json      @default("{}")

  steps     AgentStep[]
  approvals Approval[]
}

model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index     Int
  type      String // TEXT | TOOL_CALL | TOOL_RESULT | APPROVAL_REQUEST | QA_REVIEW | ERROR
  toolName  String?
  content   String // plain text, or JSON string for tool inputs/outputs
  riskLevel String? // LOW | MEDIUM | HIGH
  createdAt DateTime @default(now())
}

model Approval {
  id          String    @id @default(cuid())
  runId       String
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  toolName    String
  toolInput   String // JSON
  toolUseId   String // provider tool_use id, echoed back into the conversation on resume
  riskLevel   String // LOW | MEDIUM | HIGH
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason      String?
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  deciderId   String?
  decider     User?     @relation("decider", fields: [deciderId], references: [id])
}

// A desk skill: a procedure this desk has decided to always follow, written
// as a Markdown document (YAML frontmatter: name, description, categories;
// body = the procedure). Seeded from skills/<slug>/SKILL.md and editable from
// the UI in the same format.
//
// Agent memory (search_tickets) is what the desk DID; a skill is what the desk
// decided to ALWAYS DO. The resolver sees only name + description in its system
// prompt and loads a body on demand with read_skill — the catalogue stays cheap
// however many skills exist — and QA reviews the run against the skills that
// applied to the ticket.
model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String // the catalogue line the resolver chooses from; required
  categories  String   @default("[]") // JSON: Category[] ([] = applies to every ticket)
  body        String // the procedure, loaded by read_skill
  markdown    String // raw SKILL.md source (frontmatter + body)
  enabled     Boolean  @default(true)
  // The ticket this skill was distilled from (reb-05), when it was: the
  // KPIs count the COLUMN (reb-06), never the frontmatter. Bare FK by
  // design, like AgentRun.agentUserId — nothing navigates the reverse edge.
  sourceTicketId String?
  // cnp-06 provenance: bundled ("local") or plugin-originated ("plugin:<name>").
  // Distillation provenance is sourceTicketId (reb-05) — orthogonal; there is
  // no third column.
  origin        String   @default("local")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A specialized resolver persona defined as a Markdown document (YAML
// frontmatter: name, description, categories, tools; body = system prompt).
// Seeded from agents/*.md and editable from the UI in the same format.
model AgentProfile {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @default("")
  categories   String   @default("[]") // JSON: Category[] this specialist covers
  tools        String   @default("[]") // JSON: allowed tool names ([] = all enabled tools)
  systemPrompt String // markdown body appended to the resolver system prompt
  markdown     String // raw .md source (frontmatter + body)
  enabled      Boolean  @default(true)
  // cnp-06 provenance, same shape as Skill.origin.
  origin       String   @default("local")
  // Which pool credential this agent runs on; null = the default BYOK config.
  credentialId String?
  credential   AiCredential? @relation(fields: [credentialId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs AgentRun[]
}

// A named BYOK credential in the pool, assignable to specialized agents.
// The key itself is never returned by the API.
model AiCredential {
  id        String   @id @default(cuid())
  name      String   @unique
  provider  String // anthropic | zai | openai
  apiKey    String
  baseUrl   String   @default("")
  model     String   @default("")
  createdAt DateTime @default(now())

  profiles AgentProfile[]
}

// One row per model call — the raw material for per-key/per-agent throughput.
model AiUsage {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  credentialName String // pool credential name, "default", or "mock"
  provider       String
  model          String
  kind           String // TRIAGE | RESOLVE | QA | DRAFT
  agentName      String // system agent or specialized profile name
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  latencyMs      Int
  ok             Boolean  @default(true)
  error          String?
}

model ToolPolicy {
  toolName         String  @id
  description      String
  riskLevel        String // LOW | MEDIUM | HIGH
  enabled          Boolean @default(true)
  requiresApproval Boolean @default(false)
}

// One row per MCP tools/call — executed, refused or thrown. External MCP
// clients run outside the engine loop, so they leave no AgentRun/AgentStep
// trail; this is the audit record for that surface. `decision` is the
// McpCallDecision union in src/lib/types.ts.
model McpCall {
  id            String   @id @default(cuid())
  toolName      String
  inputJson     String // JSON string, parsed defensively on read
  resultPreview String // truncated to RESULT_LIMIT (4000)
  decision      String // EXECUTED | REFUSED_POLICY | REFUSED_UNKNOWN | ERROR
  callerLabel   String   @default("mcp-external")
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// An external MCP server Servo connects to as a CLIENT (cnp-02). v1 is
// Streamable HTTP only, tools only, static header auth only — `transport` is
// a String so "stdio" is data rather than a migration when it arrives.
// `toolsJson` is the last tools/list snapshot: [{name, description,
// inputSchema, hash}], where hash is sha256(name+description+inputSchema) and
// drives the tighten-only re-quarantine. `secret` is sealed by the $extends
// write hook in src/lib/db.ts and opened only inside src/lib/mcp-client.ts.
// Tools materialise as ToolPolicy rows named mcp__<slug>__<tool>, always with
// the §0.8 rail-4 quarantine triple.
model McpServer {
  id         String    @id @default(cuid())
  slug       String    @unique // ^[a-z][a-z0-9-]{1,30}$ — becomes the mcp__<slug>__ prefix
  name       String
  transport  String    @default("http") // "http" in v1; "stdio" reserved for roadmap
  url        String
  headers    String    @default("{}") // JSON object; values may contain {secret}
  secret     String    @default("") // bearer token / API key; never returned by the API
  enabled    Boolean   @default(false)
  toolsJson  String    @default("[]") // last tools/list snapshot
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// An admin-defined HTTP tool/integration the resolver can call. Enable/disable
// and risk/approval live in the matching ToolPolicy row (same toolName).
// {input.field} placeholders are substituted from the model's tool input;
// {secret} resolves to the stored secret (never returned by the API).
model CustomTool {
  id           String   @id @default(cuid())
  name         String   @unique // snake_case tool name exposed to the model
  description  String
  inputSchema  String   @default("{\"type\":\"object\",\"properties\":{}}") // JSON Schema for the tool input
  method       String   @default("POST") // GET | POST | PUT | PATCH | DELETE
  url          String // request URL; may contain {input.field}
  headers      String   @default("{}") // JSON object; values may contain {secret}
  bodyTemplate String   @default("") // request body; {input.field}/{secret}; empty POST body = raw input JSON
  secret       String   @default("") // bearer token / API key; never exposed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

// Outbound webhook endpoint. `events` is a JSON array of subscribed event
// names, or ["*"] for everything. Payloads are signed with HMAC-SHA256 of the
// raw body using `secret` (x-servo-signature: sha256=<hex>).
model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String // never returned by the API after creation
  events    String   @default("[\"*\"]")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]
}

// One delivery attempt (kept as a short rolling log per webhook).
model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  ok         Boolean
  statusCode Int?
  error      String?
  durationMs Int
  createdAt  DateTime @default(now())
}

// Response/resolution targets per priority. One row per Priority value.
model SlaPolicy {
  priority          String  @id // LOW | MEDIUM | HIGH | URGENT
  responseMinutes   Int
  resolutionMinutes Int
  // Raise the ticket one escalation tier when a target is missed.
  escalateOnBreach  Boolean @default(true)
}


// The company knowledge base (spec §5). Access control is not a feature of
// this area — it IS the area: retrieval is entitlement-filtered in SQL before
// candidate selection, before scoring, before anything reaches model context.
model Document {
  id          String   @id @default(cuid())
  name        String
  contentType String // application/pdf | xlsx mime | text/markdown | text/plain
  byteSize    Int
  sha256      String // dedupe + "this file changed" detection
  // Nullable since cat-01: a catalog card's canonical profile lives in
  // CatalogEntry.profile and its data is NULL by the migration's CHECK —
  // every redaction made in the renderer would be bypassed by one download.
  data        Bytes? // bytea; never selected outside the download route
  // GONE (xds-01) is the tombstone deletion propagation will write: the record
  // was indexed once and has since been removed upstream. textStatus has never
  // carried a CHECK, so the value was always STORABLE and this item does not
  // change that; what it adds is the name. Nothing WRITES it and nothing
  // EXCLUDES it yet
  // — the read-path exclusion arrives with xds-02's source clause and the
  // writer with xds-06. Like every other textStatus value it is a documented
  // String, not a CHECK, so a typo stores identically.
  textStatus  String   @default("PENDING") // PENDING | EXTRACTING | EXTRACTED | FAILED | UNSUPPORTED | GONE
  textError   String?
  // Extractor provenance (dcl-01): which extractor id produced the chunks,
  // the exact library versions it names, which extractor answered instead
  // when the preferred one was unavailable (NULL on every successful
  // non-fallback extraction — the "the sidecar was down" queue drains by
  // this being NULL again), and when the chunks were made.
  extractor         String    @default("baseline")
  extractorVersion  String    @default("")
  extractorFallback String?
  extractedAt       DateTime?
  summary     String   @default("") // deterministic extract — no model call at ingest
  keywords    Json     @default("[]") // string[]
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  collectionId String?
  collection  Collection? @relation(fields: [collectionId], references: [id])
  visibility  String   @default("PRIVATE") // PRIVATE | STAFF | PUBLIC
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks   DocumentChunk[]
  facts    DocumentFact[]
  edgesOut KnowledgeEdge[] @relation("edgeFrom")
  edgesIn  KnowledgeEdge[] @relation("edgeTo")
  grants   KbGrant[]
  // The catalog split (cat-01): a rendered catalog card is a Document whose
  // data is NULL — the canonical profile lives in CatalogEntry.profile —
  // back-linked by catalogEntryId. FILE is every ordinary upload.
  kind           String   @default("FILE") // FILE | CATALOG
  catalogEntryId String?  @unique

  // The connection layer (xds-01). A crawled record IS a Document, which is
  // why INDEX mode needs no second retrieval path. onDelete: Restrict because
  // deleting a source while its documents remain would orphan every citation
  // that names them — disable is the reversible action, purge the deliberate
  // one. externalVersion is the S3 ETag or the sha256 of a rendered row;
  // externalSeenAt is the generation stamp deletion propagation reads.
  sourceId        String?
  source          DataSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalLocator Json?
  externalVersion String?
  externalSeenAt  DateTime?
  // xds-05: when THIS document's last crawl run started — the honest
  // companion to externalSeenAt (a document seen unchanged was still seen).
  runStartedAt    DateTime?
}


// ext-01: a typed fact extracted from a chunk (dates, money, identifiers,
// quantities, emails, URLs — the ext-02/03 rulesets). String unions, no
// Prisma enums; a fact is a fragment of document content, so the RLS
// backstop covers it from birth (see 0011's header).
model DocumentFact {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkId    String
  chunk      DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  kind       String // DATE | MONEY | DURATION | IDENTIFIER | QUANTITY | EMAIL | URL
  norm       String // the normalized value — the joinable form
  num        Decimal? @db.Decimal(38, 6)
  unit       String // ISO currency code, "s", the quantity unit, or ""
  ts         BigInt?
  tsEnd      BigInt?
  text       String
  offset     Int
  length     Int
  confidence String   @default("EXACT")
  extractor  String // e.g. "facts@1" (ext-03)
  createdAt  DateTime @default(now())

  @@unique([chunkId, offset, kind])
  @@index([documentId, kind])
  @@index([kind, norm])
  @@index([kind, num])
  @@index([kind, ts])
}

model DocumentChunk {
  id        String   @id @default(cuid())
  documentId String
  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index     Int
  text      String
  locator   Json // {"sheet":"2026","range":"B4:D9"} | {"page":12} | {"lines":"120-180"} | {"entry":"...","section":"columns","from":"net_pay"} (cat-01)
  keywords  Json     @default("[]")
  // pgvector. Nullable so keyword-only installs are a normal state rather
  // than a failure; the tsvector/generated + GIN + HNSW objects live in the
  // hand-written migration (Prisma cannot express them).
  embedding      Unsupported("vector(1536)")?
  embeddingModel String @default("") // "" = none, "mock" = deterministic mock embedder
  embeddingDims  Int     @default(0) // native dimension before zero-padding
  createdAt      DateTime @default(now())

  @@unique([documentId, index])
  @@index([documentId])
  facts     DocumentFact[]
}

model Collection {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())

  documents Document[]
  grants    KbGrant[]
}

model KnowledgeEdge {
  id        String   @id @default(cuid())
  fromId    String
  from      Document @relation("edgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Document @relation("edgeTo", fields: [toId], references: [id], onDelete: Cascade)
  kind      String // SHARED_ENTITY | SHARED_KEYWORD | SAME_COLLECTION | SHARED_FACT
  weight    Float    @default(0)
  evidence  Json     @default("[]") // the shared entities/keywords — withheld unless both nodes entitled
  createdAt DateTime @default(now())

  @@unique([fromId, toId, kind])
}

// One grant of `access` on one target to one subject. Nullable FKs keep
// referential integrity; the real uniqueness and the exactly-one rule are
// the partial indexes and the CHECK in the migration — Prisma cannot
// express either.
model KbGrant {
  id           String      @id @default(cuid())
  documentId   String?
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // The third target type (xds-01). A DataSource grant is a CEILING, not a
  // floor: it is applied once outside the entitlement union, so it never
  // grants the documents a source fed — both a source grant and a document
  // path are required. The one-target CHECK is widened to num_nonnulls(...) = 1.
  sourceId     String?
  source       DataSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  subjectType  String // USER | GROUP | AGENT
  subjectId    String // User.id | Group.id | AgentProfile.id | "builtin:*"
  access       String      @default("READ") // READ | MANAGE
  grantedById  String
  grantedBy    User        @relation("kbGranter", fields: [grantedById], references: [id])
  createdAt    DateTime    @default(now())
}

// An external store Servo does not own (xds-01, canonized in
// docs/design/external-sources.md). INDEX is the only mode in v1 — crawled
// content becomes ordinary Document rows, so the one entitlement statement
// keeps working and there is no second retrieval path. Every union below is a
// String pinned by a CHECK in the migration, never a Prisma enum and never a
// JavaScript-only validator: a row written by a seed, a migration or a direct
// write is as constrained as one written by the route.
//
// configJson is NON-SECRET only (endpoint, region, host, port, database, ssl);
// the credential lives in the sealed store under secretRef. scopeJson is the
// whole security model of the connection — an explicit allowlist with no
// wildcard and no free-text `where`, EMPTY by default, which reaches nothing.
model DataSource {
  id                 String    @id @default(cuid())
  name               String    @unique
  kind               String // S3 | POSTGRES              (CHECK-pinned)
  mode               String    @default("INDEX") // INDEX only in v1        (CHECK-pinned)
  configJson         Json      @default("{}")
  secretRef          String // a Setting key — never the credential itself
  scopeJson          Json      @default("[]")
  status             String    @default("DISABLED") // DISABLED | READY | SYNCING | ERROR | UNREACHABLE | PURGED
  statusError        String?
  lastSyncAt         DateTime?
  lastCompleteSyncAt DateTime? // only a COMPLETE crawl may propagate deletions
  cursorJson         Json      @default("{}")
  syncEveryMin       Int       @default(0) // a HINT for the external caller; Servo has no scheduler
  maxRows            Int       @default(20000)
  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  documents Document[]
  grants    KbGrant[]
}

// The catalog (cat-01, canonized verbatim in docs/design/data-fabric.md):
// CatalogEntry is the structured fact, Document its rendered description,
// written in one transaction. String unions, no Prisma enums; Json for
// locator/profile/exemplars/signature/provenance/cursor/stats. dataSourceId
// is a PLAIN STRING with no FK until the connection-layer merge — see
// src/lib/catalog/datasource-contract.ts, the only shared surface.
model CatalogEntry {
  id              String    @id @default(cuid())
  dataSourceId    String // the connection layer's row; contract fragment until the merge
  level           String // SOURCE | DATASET | FIELD
  parentId        String? // FIELD -> DATASET -> SOURCE; null at SOURCE
  fqn             String // "pg://warehouse/public.payroll#net_pay" | "s3://exports/finance/2026/"
  displayName     String
  locator         Json      @default("{}") // {schema,table} | {schema,table,column} | {prefix} | {prefix,field}
  physicalType    String    @default("") // "numeric(12,2)" | "text" | "text/csv" | ""
  semanticType    String    @default("UNKNOWN") // deterministic classifier (cat-02)
  semanticScore   Float     @default(0)
  sensitivity     String    @default("UNKNOWN") // SHAPE_ONLY | INTERNAL | UNKNOWN — gates exemplars
  profile         Json      @default("{}") // shape signals only; never a row, never a rare value
  exemplars       Json      @default("[]") // [] unless the k-anonymity + INTERNAL gate passed
  signature       Json      @default("{}") // salted MinHash + LSH bands; read by the edge builder ONLY
  provenance      Json      @default("{}") // {runId, tier, method, exact, sampledRows, sampleKind, at}
  fingerprint     String    @default("") // sha256 over the STRUCTURAL part — drift detection
  valuesStatus    String    @default("ABSENT") // ABSENT | PARTIAL | COMPLETE — did tier 2 reach this entry
  note            String    @default("") // human-authored; a profile run NEVER overwrites this
  noteById        String?
  inferredPurpose String    @default("") // optional model call; a profile run NEVER overwrites this
  inferredBy      String    @default("") // "" | "mock" | model id
  profileStatus   String    @default("PENDING") // PENDING | PROFILING | PROFILED | PARTIAL | FAILED | DROPPED | UNREADABLE
  profileError    String?
  documentId      String? // the rendered card — SOURCE and DATASET only
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  droppedAt       DateTime?

  @@unique([dataSourceId, fqn])
  @@index([dataSourceId, level])
  @@index([parentId])
  @@index([documentId])
}

// One profiling pass over one DataSource (cat-01). A budget breach is
// PARTIAL with budgetHit naming the cap and cursor naming where to resume —
// never a FAILED run that leaves an operator with nothing.
model CatalogRun {
  id           String    @id @default(cuid())
  dataSourceId String
  trigger      String // CONNECT | SCHEDULED | MANUAL
  tier         String // TIER1 | TIER2 | EDGES
  status       String    @default("RUNNING") // RUNNING | COMPLETE | PARTIAL | FAILED
  cursor       Json      @default("{}") // resume point: {lastFqn, pass}
  stats        Json      @default("{}") // {datasets, fields, added[], removed[], retyped[], bytesRead, objectsOpened, rowsSampled, pairsCompared, elapsedMs}
  budgetHit    String? // WALL_CLOCK | BYTES | OBJECTS | ROWS | PAIRS | STATEMENT_TIMEOUT
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([dataSourceId, startedAt])
}
