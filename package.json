{
  "name": "servo",
  "version": "1.0.0",
  "private": true,
  "description": "The open-source desk where humans and AI agents work one queue - and every resolved ticket can become a skill your AI runs next time. Self-host it, bring your own key.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "setup": "prisma generate && prisma db push && tsx prisma/seed-core.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "prisma generate && prisma db push && tsx prisma/seed-demo.ts",
    "lint:hex": "node scripts/no-hex-lint.mjs",
    "claims:audit": "node scripts/claims-audit.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed-core.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "imapflow": "^1.6.6",
    "lucide-react": "^1.28.0",
    "mailparser": "^3.9.15",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.4",
    "puppeteer-core": "^25.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "gifenc": "^1.0.3",
    "oauth2-mock-server": "^9.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
